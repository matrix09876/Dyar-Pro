# وضع الديمو — يعمل بالكامل على محاكيات Firebase المحلية بلا أي مفاتيح حقيقية.
# الاستخدام: cp .env.demo .env  ثم شغّل المحاكيات (انظر README الجذر).
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-dyar.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-dyar
VITE_FIREBASE_STORAGE_BUCKET=demo-dyar.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_EMULATORS=true
